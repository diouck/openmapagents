# =============================================================
# OpenMapAgents - Exemple de configuration
# Copier ce fichier en "backend/.env" puis remplir les valeurs.
# Le vrai .env est gitignore : ne JAMAIS le committer.
# =============================================================

# --- MCP / Orchestrateur ---
MCP_ENABLED=true
ENABLE_RAG=true
ENABLE_MULTI_AGENT=true
ENABLE_DEBATE=true
ENABLE_VALIDATION=true
ORCHESTRATOR_TIMEOUT_S=60
MCP_STEP_TIMEOUT_S=300
ROUTER_CONFIDENCE_HIGH=0.85
ROUTER_CONFIDENCE_LOW=0.55

# --- Logs / admin ---
ADMIN_TOKEN=change-me
OMA_LOG_FILE=logs/oma_requests.jsonl
OMA_CONF_ALERT=0.60

# --- Cache / Redis (optionnel) ---
REDIS_URL=redis://localhost:6379
CACHE_MAX_RAM_ENTRIES=10000

# --- PostgreSQL / pgvector ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=openmapagents
PG_USER=postgres
PG_PASSWORD=change-me

# --- Embeddings ---
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBED_DIM=768

# --- LLM ---
# provider: claude | openai | ollama | openrouter | deepseek | mistral
LLM_PROVIDER=openrouter
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o
OLLAMA_MODEL=ollama/llama3.1
OPENROUTER_MODEL=openrouter/openrouter/free
DEEPSEEK_MODEL=openrouter/deepseek/deepseek-chat
MISTRAL_MODEL=mistral/mistral-large-latest

# --- Cles API (remplir uniquement le provider choisi) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# --- Front (Vite) ---
VITE_LITELLM_API_URL=/api/llm
VITE_LITELLM_API_KEY=OPENROUTER_API_KEY
VITE_OPENAI_MODEL=OPENROUTER_MODEL
VITE_MAPBOX_TOKEN=
VITE_CHAT_INPUT=false

# --- Ollama (local, pas de cle) ---
OLLAMA_API_BASE=http://localhost:11434

# --- Overture Maps ---
OVERTURE_RELEASE=2026-03-18.0
OVERTURE_S3_REGION=us-west-2

# --- DuckDB ---
DUCKDB_MEMORY=4GB
DUCKDB_THREADS=4

# --- Serveur ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Cartographie ---
MAPTILER_API_KEY=
MAPBOX_ACCESS_TOKEN=

# --- Google Earth Engine ---
# Chemin local vers les credentials earthengine (adapter a ta machine)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/.config/earthengine/credentials
GEE_CLIENT_ID=
GEE_CLIENT_SECRET=

# --- Securite ---
JWT_SECRET=change-me-with-a-long-random-string
