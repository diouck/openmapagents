# Variables de build du frontend (Vite).
#
# Copier en `.env` (ou `.env.production`) puis relancer `npm run build`.
# Vite fige ces valeurs DANS le bundle au moment du build : les modifier sans
# rebuilder n'a aucun effet, redémarrer le serveur ne suffit pas.

# Saisie libre dans le chat.
#   false → la zone de saisie est retirée (instance en consultation seule)
#   true  → saisie active (valeur par défaut si la variable est absente)
# Les envois déclenchés par les autres panneaux restent actifs dans les deux cas.
VITE_CHAT_INPUT=true

# URL de l'API backend. Par défaut le frontend appelle /api (même origine),
# ce qui convient derrière un reverse proxy.
# VITE_API_URL=http://localhost:8000
